{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://windbound.local/cas/common.schema.json",
 "title": "Character Asset Studio pipeline — shared definitions (v0.5)",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "relPath": {
   "type": "string",
   "pattern": "^(?!/)(?!.*\\.\\./)[^\\\\]+$",
   "description": "repository-relative POSIX path"
  },
  "view": {
   "enum": [
    "front",
    "back",
    "left",
    "right"
   ]
  },
  "canvas": {
   "type": "object",
   "required": [
    "width",
    "height"
   ],
   "additionalProperties": false,
   "properties": {
    "width": {
     "type": "integer",
     "minimum": 1
    },
    "height": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "norm": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 1
   },
   "minItems": 2,
   "maxItems": 2,
   "description": "normalised [x,y] in 0..1 of the canvas (or region)"
  },
  "px": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "confidence": {
   "enum": [
    "high",
    "medium",
    "low",
    "provisional"
   ]
  },
  "assetStatus": {
   "enum": [
    "UNAPPROVED_CANDIDATE",
    "UNAPPROVED_REFERENCE",
    "UNAPPROVED_INSTRUCTION",
    "CANONICAL_PROTECTED",
    "DIRECTOR_APPROVED",
    "SUPERSEDED",
    "BLOCKED"
   ],
   "description": "Pipeline tools only ever write UNAPPROVED_* or BLOCKED. CANONICAL_PROTECTED / DIRECTOR_APPROVED are set by a human (director) record, never automatically."
  },
  "qaResult": {
   "enum": [
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT_RUN"
   ]
  },
  "fileRef": {
   "type": "object",
   "required": [
    "path"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "$ref": "#/$defs/relPath"
    },
    "sha256": {
     "$ref": "#/$defs/sha256"
    },
    "width": {
     "type": "integer"
    },
    "height": {
     "type": "integer"
    },
    "mode": {
     "type": "string"
    }
   }
  },
  "anchor": {
   "type": "object",
   "required": [
    "px",
    "n"
   ],
   "additionalProperties": false,
   "properties": {
    "px": {
     "$ref": "#/$defs/px"
    },
    "n": {
     "$ref": "#/$defs/norm"
    },
    "definition": {
     "type": "string"
    }
   }
  },
  "approval": {
   "type": "object",
   "required": [
    "by",
    "date",
    "decision"
   ],
   "additionalProperties": false,
   "description": "human decision record; never generated by pipeline tools",
   "properties": {
    "by": {
     "type": "string"
    },
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "decision": {
     "enum": [
      "approved",
      "rejected",
      "needs_changes"
     ]
    },
    "note": {
     "type": "string"
    }
   }
  }
 }
}
