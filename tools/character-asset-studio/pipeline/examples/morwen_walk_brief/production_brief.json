  "constraints": [
    {
      "check": "automated",
      "id": "canon_protected",
      "text": "Do not edit, overwrite, re-encode or move protected canonical files; use them as visual references only."
    },
    {
      "check": "automated",
      "id": "no_auto_adoption",
      "text": "Every delivered image is UNAPPROVED_CANDIDATE until a director approval record exists."
    },
    {
      "check": "human",
      "id": "age_and_body_unchanged",
      "text": "Keep the character's age, body and proportions; no sexualised emphasis (Morwen is 17)."
    },
    {
      "check": "human",
      "id": "no_guessed_structure",
      "text": "Do not invent unconfirmed equipment or costume structure; mark unknown regions in the delivery note."
    },
    {
      "check": "automated",
      "id": "real_alpha",
      "text": "Transparent background must be real alpha=0, not a painted checkerboard or solid colour."
    },
    {
      "check": "automated",
      "id": "shared_anchor",
      "text": "All views and frames share the same canvas and anchor; feet contact the ground line at the anchor."
    },
    {
      "check": "human",
      "id": "constraint:robe_front_open",
      "text": "ローブ前面は開いている（スカート・脚・ブーツが見える）",
      "views": [
        "front"
      ]
    },
    {
      "check": "human",
      "id": "constraint:robe_rear_slit",
      "text": "背面中央のスリットからプリーツスカート・ガーター・脚が見える／脚を覆う中央の長布はない",
      "views": [
        "back"
      ]
    },
    {
      "check": "human",
      "id": "constraint:robe_hem_left",
      "text": "ローブ左側の裾は大きく広がり、かかと付近まで届く",
      "views": [
        "front",
        "back",
        "left"
      ]
    },
    {
      "check": "human",
      "id": "constraint:robe_hem_right",
      "text": "ローブ右側の裾は大きく広がり、かかと付近まで届く",
      "views": [
        "front",
        "back",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:bag_strap",
      "text": "肩掛けバッグと紐の左右位置・掛け方が方向ごとに正しい（自動反転しない）",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:socks_garter",
      "text": "ニーソックス（タイツではない）とガーター装飾の配置が正本どおり",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:skirt_check_right",
      "text": "スカートのチェック柄はキャラクター右側のみ（方向ごとに確認、自動反転しない）",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:arm_sleeve_robe",
      "text": "腕・袖・ローブの前後関係が自然",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:hat_invariants",
      "text": "帽子の花の向き、花下の緑の葉、金の月桂樹（帽子帯）",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "check": "human",
      "id": "constraint:alpha_zero_bg",
      "text": "納品PNGの背景は本物の alpha=0（チェッカー焼き込みなし）",
      "views": [
        "front",
        "back",
        "left",
        "right"
      ]
    }
  ],
